          "cachedResultName": "models/gemini-flash-latest"
        },
        "messages": {
          "values": [
            {
              "content": "=Analyse ce texte de CV et transforme-le en JSON structuré avec les champs suivants :\n- full_name\n- email\n- phone_number\n- education (liste avec institution, degree, dates)\n- experience (liste avec title, company, dates, description)\n- technical_skills\n- soft_skills\n- summary (3 lignes max)\nLe texte du CV est : {{ $json[\"text\"] }}\n\nLe json doit etre entre {} sans des ```\n"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        448,
        -400
      ],
      "id": "8bae9f8e-1ec2-4845-861f-ec01b025e6f4",
      "name": "Message a model1",
      "credentials": {
        "googlePalmApi": {
          "id": "2gderOe43uOAfJvg",
          "name": "Google Gemini(PaLM) Api account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parser le JSON\nlet jsonText = $input.first().json.content.parts[0].text;\njsonText = jsonText.replace(/```json|```/g, '').trim();\n\nconst firstBrace = jsonText.indexOf('{');\nlet braceCount = 0;\nlet lastBrace = -1;\n\nfor (let i = firstBrace; i < jsonText.length; i++) {\n  if (jsonText[i] === '{') braceCount++;\n  if (jsonText[i] === '}') {\n    braceCount--;\n    if (braceCount === 0) {\n      lastBrace = i;\n      break;\n    }\n  }\n}\n\nconst validJson = jsonText.substring(firstBrace, lastBrace + 1);\nconst data = JSON.parse(validJson);\n\n// FORMATER EN TEXTE LISIBLE\nconst educationText = data.education\n  .map((e, i) => `${i+1}. ${e.institution} - ${e.degree} (${e.dates})`)\n  .join('\\n');\n\nconst experienceText = data.experience\n  .map((e, i) => `${i+1}. ${e.title} chez ${e.company} (${e.dates})`)\n  .join('\\n');\n\nconst skillsText = Object.entries(data.technical_skills)\n  .map(([cat, skills]) => `${cat}: ${skills.join(', ')}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    full_name: data.full_name,\n    email: data.email,\n    phone_number: data.phone_number,\n    education: educationText,\n    experience: experienceText,\n    technical_skills: skillsText,\n    soft_skills: data.soft_skills.join(', '),\n    summary: data.summary,\n    date_import: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

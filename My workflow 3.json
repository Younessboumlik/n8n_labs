    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\nif (!staticData.results || !Array.isArray(staticData.results)) {\n  staticData.results = [];\n}\n\nconst outputs = [];\n\nlet cityName = $(\"Loop Over Items\").first().json.city;\n\n\nfor (const item of $input.all()) {\n  const temp = Number(item.json.current?.temperature_2m ?? item.json.temp_c ?? 20);\n  const wind = Number(item.json.current?.wind_speed_10m ?? item.json.wind_kmh ?? 0);\n  const rain = Number(item.json.current?.precipitation ?? item.json.rain_mm ?? 0);\n  const aqi = Number(item.json.currentair?.european_aqi ?? item.json.aqi ?? 0);\n\n  let tempScore;\n  if (temp < 0 || temp > 35) {\n    tempScore = 100;\n  } else {\n    tempScore = (Math.abs(temp - 20) / 15) * 100;\n  }\n  if (tempScore > 100) tempScore = 100;\n\n  let windScore = wind;\n  if (windScore > 100) windScore = 100;\n  if (windScore < 0) windScore = 0;\n\n  let rainScore;\n  if (rain > 10) rainScore = 100;\n  else rainScore = rain * 10; \n\n  let aqiScore = aqi;\n  if (aqiScore > 100) aqiScore = 100;\n  if (aqiScore < 0) aqiScore = 0;\n\n  const totalScore = (tempScore * 0.30) + (windScore * 0.25) + (rainScore * 0.25) + (aqiScore * 0.20);\n  const roundedScore = Math.round(Math.min(Math.max(totalScore, 0), 100));\n\n  let level = 'VERT';\n  let color_code = '#2ecc71';\n  if (roundedScore > 80) {\n    level = 'ROUGE';\n    color_code = '#e74c3c';\n  } else if (roundedScore > 60) {\n    level = 'ORANGE';\n    color_code = '#e67e22';\n  } else if (roundedScore > 30) {\n    level = 'JAUNE';\n    color_code = '#f1c40f';\n  }\n\n  const result = {\n    city: cityName,\n    latitude: item.json.latitude ?? item.json.lat ?? null,\n    longitude: item.json.longitude ?? item.json.lon ?? null,\n    temp_c: temp,\n    wind_kmh: wind,\n    rain_mm: rain,\n    aqi: aqi,\n    risk_score: roundedScore,\n    alert_level: level,\n    color_code,\n    raw: item.json\n  };\n\n  staticData.results.push(result);\n\n  outputs.push({ json: result });\n}\n\nreturn outputs;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

      "id": "80bf7e10-94c6-471f-ae2d-1a45f2bddb60",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nlet cities = Array.isArray(staticData.results) ? staticData.results : [];\n\nif (!cities.length) {\n  cities = $input.all().map(i => i.json);\n}\n\nconst redCities = [];\nlet rows = \"\";\n\nfor (const c of cities) {\n  const city = c.city ?? 'Unknown';\n  const temp = (c.temp_c !== undefined) ? `${c.temp_c}°C` : 'N/A';\n  const aqi = (c.aqi !== undefined) ? c.aqi : 'N/A';\n  const score = (c.risk_score !== undefined) ? `${c.risk_score}/100` : 'N/A';\n  const level = c.alert_level ?? 'N/A';\n  const color = c.color_code ?? (level === 'ROUGE' ? '#e74c3c' : level === 'ORANGE' ? '#e67e22' : level === 'JAUNE' ? '#f1c40f' : '#2ecc71');\n\n  if (level === 'ROUGE') redCities.push(city);\n\n  rows += `\n    <tr>\n      <td><strong>${city}</strong></td>\n      <td>${temp}</td>\n      <td>${aqi}</td>\n      <td><strong>${score}</strong></td>\n      <td><span class=\"badge\" style=\"background-color: ${color}\">${level}</span></td>\n    </tr>\n  `;\n}\n\nconst html = `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\" />\n  <title>Dashboard Météo</title>\n  <style>\n    body { font-family: Arial, Helvetica, sans-serif; padding: 20px; }\n    table { width: 100%; border-collapse: collapse; box-shadow: 0 2px 6px rgba(0,0,0,0.08); }\n    th { background: #333; color: white; padding: 12px; text-align: left; }\n    td { padding: 10px; border-bottom: 1px solid #eee; }\n    .badge { padding: 6px 10px; border-radius: 4px; color: white; font-weight: bold; display:inline-block; min-width:60px; text-align:center; }\n    h2 { margin-bottom: 12px; }\n  </style>\n</head>\n<body>\n  <h2>🇪🇺 Dashboard Météo — Synthèse</h2>\n  <p>Nombre de villes: ${cities.length} • Alerte rouge: ${redCities.length > 0 ? redCities.join(', ') : 'Aucune'}</p>\n  <table>\n    <thead><tr><th>Ville</th><th>Météo</th><th>Air (AQI)</th><th>Score</th><th>Alerte</th></tr></thead>\n    <tbody>${rows}</tbody>\n  </table>\n</body>\n</html>\n`;\n\n// Générer aussi un CSV simple (; séparateur) pour export\nlet csv = 'city,latitude,longitude,temp_c,wind_kmh,rain_mm,aqi,risk_score,alert_level\\n';\nfor (const c of cities) {\n  csv += `${c.city ?? ''},${c.latitude ?? ''},${c.longitude ?? ''},${c.temp_c ?? ''},${c.wind_kmh ?? ''},${c.rain_mm ?? ''},${c.aqi ?? ''},${c.risk_score ?? ''},${c.alert_level ?? ''}\\n`;\n}\n\nreturn {\n  json: {\n    html_report: html,\n    data: cities,\n    red_alerts: redCities,\n    has_danger: redCities.length > 0,\n    csv_summary: csv\n  }\n};\n"
      },

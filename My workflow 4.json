    {
      "parameters": {
        "jsCode": "// Récupère le message de l'utilisateur\nconst userMessage = $('Telegram Trigger').item.json.message.text;\nconst userAnswer = userMessage.toUpperCase().trim();\n\n// Récupère les données du quiz en attente\nconst quizData = items[0].json;\n\n// IMPORTANT : La colonne s'appelle \"bonne reponse\" avec espace\nconst bonneReponse = $input.first().json.bonne_reponse;\n\nif (!['A', 'B', 'C'].includes(userAnswer)) {\n  return [{\n    json: {\n      isValid: false,\n      message: \"⚠️ Réponse invalide ! Merci de répondre par A, B ou C\",\n      question: quizData.qst\n    }\n  }];\n}\n\nconst isCorrect = userAnswer === bonneReponse;\n\nlet responseText;\nif (isCorrect) {\n  responseText = `✅ **BRAVO !**\\n\\nTa réponse ${userAnswer} est correcte ! 🎉`;\n} else {\n  responseText = `❌ **DOMMAGE !**\\n\\nTa réponse: ${userAnswer}\\nBonne réponse: ${bonneReponse}\\n\\nEssaie encore ! 💪`;\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    isCorrect: isCorrect,\n    userAnswer: userAnswer,\n    message: responseText,\n    question: quizData.qst,\n    status: isCorrect ? 'correct' : 'incorrect'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
